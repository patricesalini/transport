	</model>
	<model name="Demande_interieure_corse" run="true">
		<variables>
			<aux name="Converter 1" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Depense touristique en Corse » du module Economie touristique.</doc>
			</aux>
			<aux name="Converter 2" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Population corse » du module Population.</doc>
			</aux>
			<aux name="Consommation\nprivee totale" access="output">
				<eqn>Converter_1+Consommation_residents</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Consommation\nresidents" flow_concept="true" access="output">
				<eqn>Conso</eqn>
			</aux>
			<aux name="Charges et taxes menages">
				<eqn>Revenu*TxImpots_et_charges_menages</eqn>
				<units>Euros</units>
			</aux>
			<aux name="TxImpots et charges menages">
				<doc>Valeur 2011.
0,3 % de plus que la moyenne nationale.
</doc>
				<eqn>0.18</eqn>
			</aux>
			<aux name="Converter 4" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Somme Salaires » du module Activité économique.</doc>
			</aux>
			<aux name="Converter 5" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Somme revenu Capital » du module Activité économique.</doc>
			</aux>
			<aux name="Revenu">
				<eqn>Converter_5+Converter_4+(Converter_9-Retraites_versées)+Retraites_versées</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Revenu par tete">
				<eqn>Revenu/Converter_2</eqn>
			</aux>
			<stock name="Demande finale res">
				<doc>Montant global à tester</doc>
				<eqn>Init_demande_finale_res</eqn>
				<inflow>Var_DF</inflow>
				<outflow>Conso</outflow>
			</stock>
			<flow name="Var DF">
				<doc>Prend en compte l&apos;effet sur le revenu disponible de l&apos;augmentation des coûts énergétiques en particulier

On a pris le parti ici de lisser - sur un an - les données de revenu, ce qui a pour effet d&apos;amoindrir les fluctuations de court terme.</doc>
				<eqn>SMTH1(Dépense_des_ménages+Croissance_demande_liee_a_la_demographie*Demande_finale_res+Recyclage_de_la_rente,1)</eqn>
			</flow>
			<flow name="Conso">
				<eqn>Demande_finale_res</eqn>
			</flow>
			<aux name="Croissance demande liee a la demographie">
				<eqn>SMTH1(DERIVN(Converter_2,1)/Converter_2,5)</eqn>
			</aux>
			<aux name="Revenu net">
				<eqn>Revenu-Charges_et_taxes_menages</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Converter 9" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Transferts aux menages » du module Activité économique.</doc>
			</aux>
			<aux name="Trend consommation">
				<eqn>TREND(Consommation_privee_totale,1)</eqn>
			</aux>
			<aux name="Init retraites">
				<eqn>480000000</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Converter 12" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Retraités » du module Population.</doc>
			</aux>
			<stock name="Retraites versées" access="output">
				<eqn>Init_retraites</eqn>
				<inflow>var_ret</inflow>
			</stock>
			<flow name="var ret">
				<eqn>Retraites_versées*DERIVN(Converter_12,1)/Converter_12</eqn>
			</flow>
			<aux name="Converter 15" access="input">
				<units>Euros</units>
			</aux>
			<stock name="Mobilité\nautomobile">
				<eqn>Init_vehicules_km</eqn>
				<inflow>Var_Mob</inflow>
			</stock>
			<aux name="Init vehicules km">
				<doc>[Recalage 2025] Mise à l&apos;échelle de l&apos;évolution du volume de carburant 2013-2023 (hypothèse : même consommation par véhicule-km).</doc>
				<eqn>3673880438</eqn>
				<units>Vehiculeskm</units>
			</aux>
			<flow name="Var Mob">
				<eqn>(.8*(DERIVN(Revenu,1)/Revenu) -.3*(DERIVN(Converter_16,1)/Converter_16))*Mobilité_automobile</eqn>
			</flow>
			<aux name="Converter 16" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Prix Gazole au Litre » du module Energie.</doc>
			</aux>
			<aux name="Incidence Prix Gazole" access="output">
				<eqn>Consommation_des_véhicules*DERIVN(Converter_16,1)*1000*(1/.8)</eqn>
			</aux>
			<stock name="Consommation\ndes véhicules">
				<doc>Volume global de Gazole et de Super importé en Corse [Recalage 2025] Volumes_Corse xlsx : gazole 202,4 + essence 106,7 k m³ en 2023, densités 0,84 / 0,75 (2013 : 231000 t, cohérent avec 230 000 t). Années 2024-2025 non disponibles.
</doc>
				<eqn>250000</eqn>
				<inflow>Var_com</inflow>
				<units>Tonnes</units>
			</stock>
			<flow name="Var com">
				<eqn>Efficience_énergétique*Incidence_tourisme+(Consommation_des_véhicules*Efficience_énergétique*DERIVN(Mobilité_automobile,1))/Mobilité_automobile-.03*DERIVN(Converter_16,1)/Converter_16*Consommation_des_véhicules</eqn>
				<units>tonnes/yr</units>
			</flow>
			<aux name="Efficience énergétique">
				<doc>On estime ici que la crooissance se fait à consommation mointre</doc>
				<eqn>0.8</eqn>
			</aux>
			<aux name="Incidence tourisme">
				<eqn>.3*Consommation_des_véhicules*DERIVN(Converter_1,1)/Converter_1</eqn>
			</aux>
			<aux name="CU moyenne aux 100">
				<eqn>100*(1/.8)*1000*Consommation_des_véhicules/Mobilité_automobile</eqn>
				<units>liters</units>
			</aux>
			<aux name="Init demande finale res">
				<doc>Le calage de la donnée dite &quot;demande finale résidents&quot; est difficile. Elle est, dans le modèle le résultat des boucles et non d&apos;un simple équilibre comptable.</doc>
				<eqn>10800000000</eqn>
			</aux>
			<aux name="Indice Demande finale">
				<eqn>100*Demande_finale_res/INIT(Demande_finale_res)</eqn>
			</aux>
			<aux name="Tx de croissance demande finale res">
				<eqn>100*TREND(Indice_Demande_finale,1)</eqn>
			</aux>
			<aux name="Converter 18" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Tx Epargne sur VAHT » du module Activité économique.</doc>
			</aux>
			<aux name="Dépense des ménages">
				<doc>Montant estimé du revenu dépensé
De ce montant initial on retire l&apos;influence sur la dépense en volume des variations de coût (gazole, intégralement - Coût maritime, avec une elasticité - coût énergétique, entièrement).  In fine on considère que la e volume de la demande finale est diminué des augmentations de coût énergétiques directs et pour une part seulement en cequi concerne les transport maritimes. 
Cette équation peut être modifiée pour intégrer plus de coefficients, fixes ou variables, d&apos;elasticité aux coûts. 
</doc>
				<eqn>SMTH1((1-Converter_18)*Revenu_net-Converter_15-Converter_17-Incidence_Prix_Gazole-Var_des_couts_Maritime*Elasticité_aux_couts_maritimes*(1-Converter_18),1)</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Converter 19" access="input">
				<units>Euros</units>
			</aux>
			<aux name="Part de la rente nette">
				<doc>Part de la rente recyclée en dépenses dans les acquisitions immobilières
Ce chiffre est bien entendu inconnu. 
Or il apparaît qu&apos;il joue un rôle important sur le niveau de la demande intérieure.
On stabilise le taux de croissance à un niveau crédible avec une part de 50%
On ne sait si c&apos;est crédible. 
</doc>
				<eqn>0.9</eqn>
			</aux>
			<aux name="Part des résidents dans la consommation locale">
				<eqn>PERCENT(Consommation_residents/Consommation_privee_totale)</eqn>
			</aux>
			<aux name="Recyclage de la rente" access="output">
				<eqn>SMTH1(Part_de_la_rente_nette*Converter_19,Durée_lissage)</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Durée lissage">
				<doc>La durée du lissage est déterminante dans la forme prise ensuite par le cycle économique.</doc>
				<eqn>3</eqn>
			</aux>
			<aux name="Converter 20" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Indice cout Mer » du module Transport extérieur.</doc>
			</aux>
			<aux name="Converter 21" access="input">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
			</aux>
			<aux name="Somme influence des couts maritimes">
				<eqn>SUM(influence_des_couts_maritimes)</eqn>
				<units>Euros</units>
			</aux>
			<stock name="influence des couts maritimes">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<eqn>Init_part_des_couts_M</eqn>
				<inflow>Flow_1</inflow>
			</stock>
			<flow name="Flow 1">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<eqn>influence_des_couts_maritimes*Converter_21*DERIVN(Converter_20,1)/Converter_20</eqn>
			</flow>
			<aux name="Var des couts Maritime">
				<eqn>DERIVN(Somme_influence_des_couts_maritimes,1)</eqn>
			</aux>
			<aux name="Init part des couts M">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<eqn>INIT(Converter_21)</eqn>
			</aux>
			<aux name="Elasticité aux couts maritimes">
				<eqn>0.8</eqn>
			</aux>
			<aux name="Converter 17" access="input">
				<units>Euros</units>
			</aux>

	<model name="Economie_touristique" run="true">
		<variables>
			<aux name="Croissance du PIB UE" access="output">
				<doc>Variation du PIB réel en € de la zone Euro</doc>
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2025" max="2045"/>
					<yscale min="-0.05" max="0.05"/>
					<ypts>0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015,0.015</ypts>
				</gf>
			</aux>
			<stock name="Capacite d'accueil">
				<doc>Nombre de lits</doc>
				<eqn>500000</eqn>
				<inflow>Variation_capacite_accueil</inflow>
			</stock>
			<flow name="Variation\ncapacite accueil">
				<eqn>Influence_investissement*Elasticité_Capa*SMTH1(Tx_Evolution_de_la_demande*Politique_d&apos;amenage_ment*Capacite_d&apos;accueil,2)+(IF Acquisition_non_res &lt;&gt; 0 THEN DERIVN(Acquisition_non_res,1)/Acquisition_non_res ELSE 0)*Capacite_d&apos;accueil</eqn>
			</flow>
			<aux name="Duree moyenne de sejour">
				<doc>Ce nombre varie semble-t-il en fonction du fractionnement croissant des vacances (allongement, RTT, etc..)
</doc>
				<eqn>10</eqn>
			</aux>
			<stock name="Mobilite touristique" access="output">
				<doc>On prend comme base 30 millions de nuitees soit 6 millions de passagers. Le chiffre semble bn a +/- 10 %  [Recalage 2025] Même part (80 %) de la mobilité totale 2025 que celle de 2013 : hypothèse.
</doc>
				<eqn>6780000</eqn>
				<inflow>Var_mob_touristique</inflow>
			</stock>
			<aux name="Nuitees touristiques">
				<eqn>Duree_moyenne_de_sejour*Mobilite_touristique/2</eqn>
			</aux>
			<aux name="Duree moyenne de disponibilite">
				<eqn>40</eqn>
			</aux>
			<aux name="Capacite potentielle accueil">
				<eqn>Capacite_d&apos;accueil*Duree_moyenne_de_disponibilite</eqn>
			</aux>
			<aux name="Tx Evolution\nde la demande">
				<eqn>Croissance_du_PIB_UE*Elasticite_revenu</eqn>
			</aux>
			<aux name="Politique d'amenage\nment" access="output">
				<doc>Nombre sans dimension venant augmenter ou diminuer les effets strictement economiques.. 
Reflete le caractere laxiste, contraingnant ou volontariste de la politique d&apos;occupation des sols.
</doc>
				<eqn>1</eqn>
			</aux>
			<aux name="Depense moyenne par jour">
				<eqn>60</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Depense touristique en Corse" access="output">
				<eqn>Depense_moyenne_par_jour*Nuitees_touristiques</eqn>
			</aux>
			<aux name="Tx de VA moyen">
				<eqn>1/3</eqn>
			</aux>
			<aux name="valeur ajoutee HT liee directement au tourisme">
				<eqn>Depense_touristique_en_Corse*Tx_de_VA_moyen</eqn>
			</aux>
			<aux name="TVA toursime">
				<doc>Taux moyen observe : 9,5 % sur la VA</doc>
				<eqn>valeur_ajoutee_HT_liee_directement_au_tourisme*0.095</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Taxe sur les transports" access="output">
				<eqn>Mobilite_touristique*Niveau_nominal_Taxe</eqn>
			</aux>
			<aux name="Taxe de sejour" access="output">
				<eqn>Nuitees_touristiques*Niveau_moyen_taxe_sejour</eqn>
			</aux>
			<aux name="Niveau moyen taxe sejour">
				<doc>Niveau observe rapporte aux nuitees</doc>
				<eqn>0.13</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Niveau nominal Taxe">
				<eqn>4.57</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Consommations intermediaires generees par le tourisme" access="output">
				<eqn>Depense_touristique_en_Corse-valeur_ajoutee_HT_liee_directement_au_tourisme</eqn>
			</aux>
			<aux name="Depense de transport des touristes">
				<eqn>Mobilite_touristique*Cout_moyen_de_transport</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Init Cout moyen transport">
				<doc>Cout moyen estime. CA estime imputable aux &quot;visiteurs&quot; des compagnies maritimes et aeriennes. 

	CA
Residents	 175   
Visiteurs	 524   
	 699   </doc>
				<eqn>81</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Elasticite\nrevenu">
				<doc>Elasticite du seul revenu (l&apos;effet d&apos;offre retire)</doc>
				<eqn>1</eqn>
			</aux>
			<stock name="Cout moyen de transport">
				<eqn>Init_Cout_moyen_transport</eqn>
				<inflow>Var_prix_transport</inflow>
				<units>Euros</units>
			</stock>
			<flow name="Var prix transport">
				<eqn>DERIVN(Converter_3,1)*Cout_moyen_de_transport</eqn>
				<units>eur/yr</units>
			</flow>
			<aux name="Elasticite prix">
				<doc>Elasticite prix tiree des entretiens et des etudes sur d&apos;autres regions</doc>
				<eqn>-1</eqn>
			</aux>
			<aux name="Tx croissance\ncapacite accueil">
				<eqn>SMTH1(DERIVN(Capacite_d&apos;accueil,1)/Capacite_d&apos;accueil,1)</eqn>
			</aux>
			<aux name="Elasticite Offre capacite T">
				<doc>[Relié] Elasticité de la mobilité touristique à la croissance de la capacité d&apos;accueil ; elle multipliait implicitement la capacité par 1 auparavant.</doc>
				<eqn>0.7</eqn>
			</aux>
			<flow name="Var mob touristique">
				<eqn>(SMTH1(Tx_croissance_capacite_accueil,3)*Elasticite_Offre_capacite_T+SMTH1(Tx_de_croissance_prix_transort,1)*Elasticite_prix+Tx_Evolution_de_la_demande)*Mobilite_touristique</eqn>
			</flow>
			<aux name="Converter 1" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Indice cout Mer » du module Transport extérieur.</doc>
			</aux>
			<aux name="Converter 2" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Indice cout Aérien » du module Transport extérieur.</doc>
			</aux>
			<aux name="Converter 3" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Indice des prix de transport » du module Transport extérieur.</doc>
			</aux>
			<aux name="Tx de croissance prix transort">
				<doc>On prend ici comme signal prix, non pas l&apos;indice du prix des transports, mais l&apos;indice du prix minimal (mode le moins cher par rapport à 2013)
Ce choix consiste à considérer que la mobilité dépend fondamentalement - en variation - de l&apos;activisme de l&apos;offre en prix</doc>
				<eqn>SMTH1(DERIVN(Converter_4,1)/Converter_4,1)</eqn>
			</aux>
			<aux name="Converter 4" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Indice Min Cout » du module Transport extérieur.</doc>
			</aux>
			<aux name="Elasticité Capa">
				<eqn>0.8</eqn>
			</aux>
			<aux name="Converter 5" access="input">
				<units>Euros</units>
			</aux>
			<aux name="Acquisition non res">
				<eqn>Converter_5-Converter_6</eqn>
			</aux>
			<aux name="Converter 6" access="input">
				<units>Euros</units>
			</aux>
			<aux name="Converter 7" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Part tourisme » du module Appareil Productif.</doc>
			</aux>
			<aux name="Influence investissement">
				<eqn>Converter_7/INIT(Converter_7)</eqn>
			</aux>
			<isee:dependencies>
				<var name="Variation_capacite_accueil">
					<in>Tx_Evolution_de_la_demande</in>

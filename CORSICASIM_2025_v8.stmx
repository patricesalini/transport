	<sim_specs isee:simulation_delay="0" method="Euler" time_units="Years" isee:pause_after_rates="false" isee:instantaneous_flows="false">
		<start>2025</start>
		<stop>2045</stop>
		<dt reciprocal="true">48</dt>
	</sim_specs>
	<dimensions>
		<dim name="Branches">
			<elem name="Agroalimentaire"/>
			<elem name="Construction_Immobilier"/>
			<elem name="Transport"/>
			<elem name="Tourisme_Hotellerie"/>
			<elem name="Autres_produits"/>
		</dim>
		<dim name="Mix_énergétique_mer">
			<elem name="Fuel_lourd"/>
			<elem name="Gazole"/>
			<elem name="Gaz"/>
		</dim>
		<dim name="Postes_de_coût_Mer">
			<elem name="Equipage"/>
			<elem name="Sous_traitance"/>
			<elem name="Autres"/>
			<elem name="Maintenance"/>
			<elem name="Coût_du_navire"/>
		</dim>
	</dimensions>
	<isee:prefs show_module_prefix="true" live_update_on_drag="true" show_restore_buttons="true" layer="model" saved_runs="2" keep="false" rifp="false"/>
	<isee:multiplayer_settings include_chat="true" allow_observers="false" advance_time_increment="1" observer_start_page="home_page" enabled="false"/>
	<model_units/>
	<model run="true">
		<variables>
			<module name="Population">
				<connect to="Population.Converter_4" from="Activité_économique.Augmentation_du_parc"/>
				<connect to="Population.Converter_1" from="Activité_économique.Indice_Valeur_Ajoutée_Corse"/>
				<connect to="Population.Converter_3" from="Activité_économique.Acquisitions_Immo_résidents"/>
				<connect to="Population.Converter_5" from="Activité_économique.Somme_valeurs_ajoutées_brutes"/>
				<connect to="Population.Converter_2" from="Economie_touristique.Croissance_du_PIB_UE"/>
			</module>
			<module name="Economie\ntouristique">
				<connect to="Economie_touristique.Converter_6" from="Activité_économique.Acquisitions_Immo_résidents"/>
				<connect to="Economie_touristique.Converter_5" from="Activité_économique.Acquisitions_immobilières"/>
				<connect to="Economie_touristique.Converter_4" from="Transport_extérieur.Indice_Min_Cout"/>
				<connect to="Economie_touristique.Converter_2" from="Transport_extérieur.Indice_cout_Aérien"/>
				<connect to="Economie_touristique.Converter_1" from="Transport_extérieur.Indice_cout_Mer"/>
				<connect to="Economie_touristique.Converter_3" from="Transport_extérieur.Indice_des_prix_de_transport"/>
				<connect to="Economie_touristique.Converter_7" from="Appareil_Productif.Part_tourisme"/>
			</module>
			<module name="Demande\ninterieure\ncorse">
				<connect to="Demande_interieure_corse.Converter_16" from="Energie.Prix_Gazole_au_Litre"/>
				<connect to="Demande_interieure_corse.Converter_17" from="Energie.Incidence_cout_énergétique_en_termes_réel"/>
				<connect to="Demande_interieure_corse.Converter_12" from="Population.Retraités"/>
				<connect to="Demande_interieure_corse.Converter_2" from="Population.Population_corse"/>
				<connect to="Demande_interieure_corse.Converter_15" from="Transport_extérieur.Indidence_cout_Transport_Résidents"/>
				<connect to="Demande_interieure_corse.Converter_20" from="Transport_extérieur.Indice_cout_Mer"/>
				<connect to="Demande_interieure_corse.Converter_21" from="Activité_économique.Part_des_couts_de_transport_maritime_estimée"/>
				<connect to="Demande_interieure_corse.Converter_9" from="Activité_économique.Transferts_aux_menages"/>
				<connect to="Demande_interieure_corse.Converter_19" from="Activité_économique.Acquisitions_immobilières"/>
				<connect to="Demande_interieure_corse.Converter_18" from="Activité_économique.Tx_Epargne_sur_VAHT"/>
				<connect to="Demande_interieure_corse.Converter_4" from="Activité_économique.Somme_Salaires"/>
				<connect to="Demande_interieure_corse.Converter_5" from="Activité_économique.Somme_revenu_Capital"/>
				<connect to="Demande_interieure_corse.Converter_1" from="Economie_touristique.Depense_touristique_en_Corse"/>
			</module>
			<module name="Activité\néconomique">
				<connect to="Activité_économique.Converter_11" from="Population.Population_corse"/>
				<connect to="Activité_économique.Converter_7" from="Transport_extérieur.Indice_cout_Mer"/>
				<connect to="Activité_économique.Converter_3" from="Economie_touristique.Taxe_sur_les_transports"/>
				<connect to="Activité_économique.Converter_9" from="Energie.Influence_investissement_EDF"/>
				<connect to="Activité_économique.Converter_14" from="Energie.Prix_Gazole_au_Litre"/>
				<connect to="Activité_économique.Converter_4" from="Economie_touristique.Taxe_de_sejour"/>
				<connect to="Activité_économique.Converter_15" from="Energie.Perequation_et_CSPE"/>
				<connect to="Activité_économique.Converter_12" from="Demande_interieure_corse.Retraites_versées"/>
				<connect to="Activité_économique.Converter_8" from="Economie_touristique.Mobilite_touristique"/>
				<connect to="Activité_économique.Converter_1" from="Demande_interieure_corse.Consommation_residents"/>
				<connect to="Activité_économique.Converter_16" from="Appareil_Productif.Indice_CFPB_sur_initial"/>
				<connect to="Activité_économique.Converter_6" from="Population.croissance_demographique"/>
				<connect to="Activité_économique.Converter_2" from="Economie_touristique.Depense_touristique_en_Corse"/>
				<connect to="Activité_économique.Converter_13" from="Economie_touristique.Politique_d'amenage_ment"/>
				<connect to="Activité_économique.Converter_10" from="Appareil_Productif.Investissement_réel_par_branche"/>
				<connect to="Activité_économique.Converter_5" from="Appareil_Productif.Capacite_productive_AgroAlimentaire"/>
			</module>
			<module name="Appareil\nProductif">
				<connect to="Appareil_Productif.Converter_10" from="Activité_économique.Investissement_productif"/>
				<connect to="Appareil_Productif.Converter_6" from="Activité_économique.Demande_globale"/>
				<connect to="Appareil_Productif.Converter_3" from="Activité_économique.Epargne_exterieure"/>
				<connect to="Appareil_Productif.Converter_4" from="Activité_économique.Epargne_Corse_Entreprises_et_ménages"/>
				<connect to="Appareil_Productif.Converter_11" from="Activité_économique.VA"/>
				<connect to="Appareil_Productif.Converter_2" from="Activité_économique.Init_capa_Agro"/>
				<connect to="Appareil_Productif.Converter_1" from="Activité_économique.Demande_Agrolimentaire_locale"/>
			</module>
			<module name="Energie">
				<connect to="Energie.Converter_1" from="Activité_économique.Tx_de_croissance_demande"/>
				<connect to="Energie.Converter_2" from="Transport_extérieur.Indice_cout_Mer"/>
			</module>
			<module name="Transport\nextérieur">
				<connect to="Transport_extérieur.Converter_1" from="Energie.Prix_du_Gaz"/>
				<connect to="Transport_extérieur.Cout_du_FOL" from="Energie.Prix_FOL"/>
				<connect to="Transport_extérieur.Cout_du_GO" from="Energie.Prix_FOD_HTT"/>
				<connect to="Transport_extérieur.Cout_de_la_TEP" from="Energie.Prix_de_la_TEP"/>
				<connect to="Transport_extérieur.Converter_2" from="Economie_touristique.Mobilite_touristique"/>
				<connect to="Transport_extérieur.Converter_4" from="Population.Population_corse"/>
			</module>
			<isee:dependencies>
				<var name="Population">
					<in>Activité_économique</in>
					<in>Economie_touristique</in>
				</var>
				<var name="Economie_touristique">
					<in>Activité_économique</in>
					<in>Transport_extérieur</in>
					<in>Appareil_Productif</in>
				</var>
				<var name="Demande_interieure_corse">
					<in>Energie</in>
					<in>Population</in>
					<in>Activité_économique</in>
					<in>Economie_touristique</in>
					<in>Transport_extérieur</in>
				</var>
				<var name="Activité_économique">
					<in>Population</in>
					<in>Economie_touristique</in>
					<in>Energie</in>
					<in>Transport_extérieur</in>
					<in>Demande_interieure_corse</in>
					<in>Appareil_Productif</in>
				</var>
				<var name="Appareil_Productif">
					<in>Activité_économique</in>
				</var>
				<var name="Energie">
					<in>Activité_économique</in>
					<in>Transport_extérieur</in>
				</var>
				<var name="Transport_extérieur">
					<in>Energie</in>
					<in>Economie_touristique</in>
					<in>Population</in>
				</var>
			</isee:dependencies>
		</variables>

	</model>
	<model name="Energie" run="true">
		<variables>
			<aux name="Hydraulique">
				<doc>575,1 en 2010 Psserait à 680 en 2015
</doc>
				<eqn>TIME</eqn>
				<gf>
					<yscale min="500" max="750"/>
					<xpts>2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045</xpts>
					<ypts>680,680,680,680,680,680,680,680,680,680,680,680,680,680,680,680,680,680,680,680,680</ypts>
				</gf>
			</aux>
			<aux name="Thermique pointe">
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="100"/>
					<xpts>2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045</xpts>
					<ypts>60,60,60,60,60,60,60,60,60,60,60,60,60,60,60,60,60,60,60,60,60</ypts>
				</gf>
			</aux>
			<aux name="Thermique de base">
				<doc>Hypothèse de Savary en ce qui concerne le déploiement des centrales</doc>
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2025" max="2045"/>
					<yscale min="0" max="2000"/>
					<ypts>1324.76,1350.48,1427.65,1472.67,1569.13,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18,1704.18</ypts>
				</gf>
			</aux>
			<aux name="Interconnexions">
				<eqn>MAX((Dem_electrique-Thermique_de_base-Hydraulique-Eolien-Solaire-Thermique_pointe),0)</eqn>
			</aux>
			<aux name="Eolien">
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="100"/>
					<xpts>2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045</xpts>
					<ypts>44,44.3333,44.3333,46,46.6667,48,48,48,48,48,48,48,48,48,48,48,48,48,48,48,48</ypts>
				</gf>
			</aux>
			<aux name="Solaire">
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="100"/>
					<xpts>2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045</xpts>
					<ypts>68,68.3333,71,72.6667,73,74,74,74,74,74,74,74,74,74,74,74,74,74,74,74,74</ypts>
				</gf>
			</aux>
			<aux name="Prix de la TEP" access="output">
				<eqn>(Prix_du_petrole*1000/158.9873)/Cours_Dollar</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Prix FOD HTT" access="output">
				<eqn>Prix_de_la_TEP+Surcout_FOD</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Prix FOL" access="output">
				<eqn>surcout_FOL_TTBTS+Prix_de_la_TEP</eqn>
			</aux>
			<aux name="Prix Electricite MD GAZ">
				<doc>Equation de Pierre Savary pour le Gaz MD</doc>
				<eqn>3.6+(Prix_du_Gaz*100)/(1.3*293.1*.4)</eqn>
			</aux>
			<aux name="Prix Interco">
				<doc>Hypotheses de Pierre. 

110 % du cout du CC Gaz</doc>
				<eqn>Cout_electricite_CC_Gaz*1.1</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Cout Eolien">
				<doc>Se stabilise à 14,5 centimes € le kwh</doc>
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="20"/>
					<xpts>2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045</xpts>
					<ypts>14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5,14.5</ypts>
				</gf>
			</aux>
			<aux name="Cout Solaire">
				<doc>Fortement decroissant dans le temps selon Pierre</doc>
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="60"/>
					<xpts>2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045</xpts>
					<ypts>15.411,15.411,15.411,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15,15</ypts>
				</gf>
			</aux>
			<aux name="Prix nucleaire">
				<doc>Hypotheses de Pierre [Hypothèse non reliée aux équations : le curseur de l&apos;interface est sans effet. À relier au prix de l&apos;interconnexion ou à supprimer.]</doc>
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="10"/>
					<xpts>2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045</xpts>
					<ypts>6.5,6.50685,6.71233,6.78082,6.95205,7,7,7,7,7,7,7,7,7,7,7,7,7,7,7,7</ypts>
				</gf>
			</aux>
			<aux name="Cout Hydro">
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2025" max="2045"/>
					<yscale min="0" max="10"/>
					<ypts>2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2,2</ypts>
				</gf>
			</aux>
			<aux name="Surcout FOD">
				<doc>Le surcoût est calculé sur la base de sept 2014. Il conviendrait de l&apos;étudier de mnaière plus dynamique</doc>
				<eqn>200</eqn>
				<units>Euros</units>
			</aux>
			<aux name="surcout FOL TTBTS">
				<doc>Le surcoût est calculé sur la base de sept 2014. Il conviendrait de l&apos;étudier de mnaière plus dynamique</doc>
				<eqn>100</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Cout kwh FOD">
				<doc>Equation de cout du kwh de Pierre Savary</doc>
				<eqn>3.6+Prix_FOD_HTT*.022</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Prix du Gaz" access="output">
				<doc>En USD / Mbtu

Derive du prix du gaz par rapport au petrole 
L&apos;equation est celle implicite de Pierre.</doc>
				<eqn>a*EXP(K*Prix_du_petrole)+d</eqn>
			</aux>
			<aux name="Cout electricite CC Gaz">
				<eqn>3+(100*Prix_du_Gaz)/(1.3*293.1*.5)</eqn>
			</aux>
			<aux name="Depense Hydraulique">
				<eqn>(Cout_Hydro/100)*Hydraulique*1000000</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Depense\nthermique de pointe">
				<eqn>(IF Gaz_ou_FOD = 1 THEN cout_pointe_Gaz*Thermique_pointe/100 ELSE Cout_pointe_FOD*Thermique_pointe/100)*1000000</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Depense Interconnexion">
				<eqn>1000000*Interconnexions*Prix_Interco/100</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Depense Eolien">
				<eqn>1000000*Eolien*Cout_Eolien/100</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Depense solaire">
				<eqn>Solaire*Cout_Solaire/100*1000000</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Depense thermique de base">
				<eqn>(IF Gaz_ou_FOD = 1 THEN Thermique_de_base* Cout_electricite_CC_Gaz/100 ELSE Thermique_de_base*Cout_kwh_FOD/100)*1000000</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Cout pointe FOD">
				<doc>Cout du thermique diesel de pointe
Source Pierre</doc>
				<eqn>Prix_FOD_HTT*.03</eqn>
			</aux>
			<aux name="cout pointe Gaz">
				<eqn>3+(100*Prix_du_Gaz)/(1.3*293.1*0.3)</eqn>
			</aux>
			<aux name="Gaz ou FOD">
				<doc>1 si Gaz
0 si FOD</doc>
				<eqn>IF TIME &gt; Année_de_passage_au_Gaz OR TIME = Année_de_passage_au_Gaz THEN 1 ELSE 0</eqn>
			</aux>
			<aux name="Depense totale Edf Corse">
				<eqn>Depense_thermique_de_pointe+Depense_thermique_de_base+Depense_Interconnexion+Depense_solaire+Depense_Eolien+Depense_Hydraulique</eqn>
			</aux>
			<aux name="Cout de production\ndu kwh corse">
				<doc>c€/kwh</doc>
				<eqn>Depense_totale_Edf_Corse/Dem_electrique/10000</eqn>
				<units>centimes d&apos;Euros</units>
			</aux>
			<aux name="Cout national du kwh">
				<eqn>TIME</eqn>
				<gf>
					<yscale min="0" max="10"/>
					<xpts>2025,2026,2027,2028,2029,2030,2031,2032,2033,2034,2035,2036,2037,2038,2039,2040,2041,2042,2043,2044,2045</xpts>
					<ypts>7.5,7.70548,7.87671,7.94521,8.18493,8.6,8.6,8.6,8.6,8.6,8.6,8.6,8.6,8.6,8.6,8.6,8.6,8.6,8.6,8.6,8.6</ypts>
				</gf>
				<units>centimes d&apos;Euros</units>
			</aux>
			<aux name="Perequation et CSPE" access="output">
				<eqn>IF TIME &gt; 2026 THEN IF Arret_péréquation= 1 THEN 0 ELSE Depense_totale_Edf_Corse-(.01*(Cout_national_du_kwh*Dem_electrique))*1000000 ELSE Depense_totale_Edf_Corse-(.01*(Cout_national_du_kwh*Dem_electrique))*1000000</eqn>
				<units>Euros</units>
			</aux>
			<aux name="K">
				<doc>Parametre de calage de l&apos;equation</doc>
				<eqn>0.0047</eqn>
			</aux>
			<aux name="a">
				<eqn>5.5</eqn>
			</aux>
			<aux name="d">
				<eqn>19</eqn>
			</aux>
			<aux name="Prix du petrole">
				<doc>Prix du Brent daté ($ le baril) en moyenne annuelle 
</doc>
				<eqn>TIME</eqn>
				<gf type="extrapolate">
					<xscale min="2025" max="2045"/>
					<yscale min="0" max="300"/>
					<ypts>69,90,70,71.4,72.83,74.28,75.77,77.29,78.83,80.41,82.02,83.66,85.33,87.04,88.78,90.55,92.36,94.21,96.09,98.02,99.98</ypts>
				</gf>
				<units>US Dollars</units>
			</aux>
			<aux name="Converter 1" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Tx de croissance demande » du module Activité économique.</doc>
			</aux>
			<aux name="Elasticite demande electrique">
				<doc>Elasticite prise positive mais faible (egale à 0,25) en gros celle relevee pour l&apos;elasticite de la conso energetique aux revenus en France

voir:  http://www.insee.fr/fr/indicateurs/analys_conj/archives/062012_d1.pdf
</doc>
				<eqn>0.25</eqn>
			</aux>
			<stock name="Dem electrique">
				<eqn>2300</eqn>
				<inflow>Var_Dem_Electrique</inflow>
				<units>GWH</units>
			</stock>
			<flow name="Var Dem Electrique">
				<eqn>.01*Converter_1*Elasticite_demande_electrique*Dem_electrique-Dem_electrique*Influence_du_prix</eqn>
			</flow>
			<aux name="Cours Dollar">
				<eqn>TIME</eqn>
				<gf type="extrapolate">
					<xscale min="2025" max="2045"/>
					<yscale min="0" max="2"/>
					<ypts>1.13,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16,1.16</ypts>
				</gf>
			</aux>
			<aux name="Incidence cout énergétique en termes réel" access="output">
				<eqn>SMTH1(DERIVN(Cout_énergétique_supporté,1),1)</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Cout énergétique supporté">
				<eqn>Depense_totale_Edf_Corse-Perequation_et_CSPE</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Arret péréquation">
				<doc>Prend une valeur égale à 1 en cas d&apos;arrêt</doc>
				<eqn>0</eqn>
			</aux>
			<aux name="Prix Gazole">
				<eqn>Taxes_gazole_TTC+Prix_FOD_HTT</eqn>
			</aux>
			<aux name="Converter 2" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Indice cout Mer » du module Transport extérieur.</doc>
			</aux>
			<aux name="Cout de transport du Pétrole en Corse">
				<eqn>1000*(Converter_2*0.15/1.4)/.8</eqn>
				<units>Euros par tonne</units>
			</aux>
			<aux name="Taxes gazole TTC">
				<eqn>(1000*(1/.8))*.85+10*Majo_cumulée_TICPE</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Prix Gazole au Litre" access="output">
				<eqn>Prix_Gazole/1000*.8</eqn>
			</aux>
			<stock name="Prix transport\npétrole">
				<eqn>0</eqn>
				<inflow>In_Prix</inflow>
				<outflow>Var_prix_transport</outflow>
			</stock>
			<flow name="In Prix">
				<eqn>DERIVN(Cout_de_transport_du_Pétrole_en_Corse,1)</eqn>
			</flow>
			<flow name="Var prix transport">
				<eqn>SMTH1(In_Prix,1)</eqn>
			</flow>
			<aux name="Année de passage au Gaz">
				<doc>[Recalage 2025] Hypothèse à valider (2020 dans la version 2013, date dépassée) : passage au gaz de la production thermique supposé en 2030.</doc>
				<eqn>2030</eqn>
			</aux>
			<aux name="Cout d'une centrale">
				<eqn>400000000</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Cout du FSRU">
				<doc>Coût d&apos;une unité de 4 millions de tonnes de capacité</doc>
				<eqn>330000000</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Annuité sur 30 ans cout refonte thermique">
				<eqn>PMT(.035,30,cout_global_refonte_système_thermique,0)</eqn>
			</aux>
			<aux name="Phasage des dépenses">
				<eqn>IF TIME &gt; (Année_de_passage_au_Gaz-1) THEN Cout_d&apos;une_centrale/4 ELSE 0</eqn>
			</aux>
			<stock name="Stock 1">
				<eqn>Cout_d&apos;une_centrale</eqn>
				<outflow>Construction_Centrale</outflow>
				<non_negative/>
				<units>Euros</units>
			</stock>
			<flow name="Construction\nCentrale">
				<eqn>Phasage_des_dépenses</eqn>
				<units>eur/yr</units>
			</flow>
			<aux name="cout global refonte système thermique">
				<eqn>Cout_d&apos;une_centrale+Cout_du_FSRU</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Influence investissement EDF" flow_concept="true" access="output">
				<doc>Je ne connais pas la part des investissements &quot;achetés&quot; en Corse</doc>
				<eqn>.6*Construction_Centrale</eqn>
			</aux>
			<aux name="Cout supporté unitaire">
				<eqn>Cout_énergétique_supporté/Dem_electrique/10000</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Influence du prix">
				<eqn>SMTH3(DERIVN(Cout_supporté_unitaire,1)/Cout_supporté_unitaire,10)</eqn>
			</aux>
			<aux name="Majo cumulée TICPE">
				<doc>En Euros pour 100 litres</doc>
				<eqn>TIME</eqn>
				<gf>
					<xscale min="2025" max="2045"/>
					<yscale min="0" max="50"/>
					<ypts>20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05,20.05</ypts>
				</gf>
				<units>Euros</units>
			</aux>
			<isee:dependencies>
				<var name="Interconnexions">
					<in>Hydraulique</in>

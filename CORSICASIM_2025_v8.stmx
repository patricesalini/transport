	</model>
	<model name="Appareil_Productif" run="true">
		<variables>
			<stock name="Capacite productive AgroAlimentaire" access="output">
				<doc>Valeur possible de la production agro-alientaire corse</doc>
				<eqn>Converter_2</eqn>
				<inflow>Var_capacit_Agricole</inflow>
				<outflow>Obsolescence_AGR</outflow>
				<non_negative/>
				<units>Euros</units>
			</stock>
			<flow name="Var capacit Agricole">
				<eqn>Capacite_productive_AgroAlimentaire*(DERIVN(Converter_1,1)/Converter_1)*Elasticite_production_agricole+Tx_de_croissance_du_CF_Agro*Capacite_productive_AgroAlimentaire</eqn>
			</flow>
			<aux name="Elasticite production agricole">
				<doc>Elasticite refletant l&apos;effet de la demande sur la capacite, avec un certain delai</doc>
				<eqn>1</eqn>
			</aux>
			<aux name="Converter 1" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Demande Agrolimentaire locale » du module Activité économique.</doc>
			</aux>
			<aux name="Converter 2" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Init capa Agro » du module Activité économique.</doc>
			</aux>
			<aux name="Converter 3" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Epargne exterieure » du module Activité économique.</doc>
			</aux>
			<aux name="Converter 4" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Epargne Corse Entreprises et ménages » du module Activité économique.</doc>
			</aux>
			<aux name="Init Ventilation de l'investissement par branche">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<eqn>Ventilation_de_l&apos;investissement</eqn>
			</aux>
			<stock name="Capital Productif" access="output">
				<eqn>Init_Capital_fixe_Branches</eqn>
				<inflow>Accumulation</inflow>
				<outflow>Obsolescence</outflow>
				<non_negative/>
			</stock>
			<flow name="Accumulation">
				<eqn>SUM(Investissement_par_branche)</eqn>
			</flow>
			<aux name="Converter 6" access="input">
				<doc>Entrée du module (reliée au niveau supérieur) : reçoit « Demande globale » du module Activité économique.</doc>
			</aux>
			<aux name="Epargne sur demande">
				<doc>[Indicateur de sortie] (Epargne Corse + épargne extérieure) / demande globale. Anciennement « S ».</doc>
				<eqn>(Converter_4+Converter_3)/Converter_6</eqn>
			</aux>
			<aux name="Init Capital fixe Branches">
				<doc>Montant estimé du capital à partir des coefficients nationaux et des valeurs vénales objserves des terres ainsi que des surcoûts de marché</doc>
				<eqn>SUM(Init_Capital_Fixe_par_branche)</eqn>
				<units>Euros</units>
			</aux>
			<flow name="Obsolescence">
				<eqn>SMTH1(Tx_d&apos;obsolescence_du_capital*Capital_Productif,1)</eqn>
				<scale min="800000000" max="1800000000"/>
			</flow>
			<aux name="Tx d'obsolescence du capital">
				<eqn>15/100</eqn>
			</aux>
			<aux name="Part de l'investissement allant à l'AgroAlim">
				<doc>La part actuelle des IAA et de l&apos;agriclture dans le capital fixe est de l&apos;ordre de 2 %.
Avec un rapport VA/capital de l&apos;ordre de 1/4

Ce paramètre est interessant à faire varier. </doc>
				<eqn>0.02</eqn>
			</aux>
			<flow name="Obsolescence AGR">
				<eqn>Capacite_productive_AgroAlimentaire/Durée_vie_inv_Agro</eqn>
				<units>eur/yr</units>
			</flow>
			<aux name="Init Capital Fixe par branche">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<element subscript="Agroalimentaire">
					<eqn>787000000</eqn>
				</element>
				<element subscript="Construction_Immobilier">
					<eqn>17891000000</eqn>
				</element>
				<element subscript="Transport">
					<eqn>560000000</eqn>
				</element>
				<element subscript="Tourisme_Hotellerie">
					<eqn>388888888</eqn>
				</element>
				<element subscript="Autres_produits">
					<eqn>2868000000</eqn>
				</element>
			</aux>
			<stock name="Capital Fixe Productif B">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<eqn>Init_Capital_Fixe_par_branche</eqn>
				<inflow>Investissement_réel_par_branche</inflow>
				<outflow>Obsolescence_CF</outflow>
				<non_negative/>
			</stock>
			<flow name="Investissement réel par branche" access="output">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<element subscript="Agroalimentaire">
					<eqn>Investissement_par_branche[Agroalimentaire]</eqn>
				</element>
				<element subscript="Construction_Immobilier">
					<eqn>Investissement_par_branche[Construction_Immobilier]</eqn>
				</element>
				<element subscript="Transport">
					<eqn>Investissement_par_branche[Transport]</eqn>
				</element>
				<element subscript="Tourisme_Hotellerie">
					<eqn>Investissement_par_branche[Tourisme_Hotellerie]</eqn>
				</element>
				<element subscript="Autres_produits">
					<eqn>Investissement_par_branche[Autres_produits]</eqn>
				</element>
				<units>Euros</units>
			</flow>
			<flow name="Obsolescence CF">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<element subscript="Agroalimentaire">
					<eqn>Capital_Fixe_Productif_B[Agroalimentaire]/100</eqn>
				</element>
				<element subscript="Construction_Immobilier">
					<eqn>Tx_d&apos;obsolescence_du_capital*Capital_Fixe_Productif_B[Construction_Immobilier]</eqn>
				</element>
				<element subscript="Transport">
					<eqn>Tx_d&apos;obsolescence_du_capital*Capital_Fixe_Productif_B[Transport]</eqn>
				</element>
				<element subscript="Tourisme_Hotellerie">
					<eqn>Tx_d&apos;obsolescence_du_capital*Capital_Fixe_Productif_B[Tourisme_Hotellerie]</eqn>
				</element>
				<element subscript="Autres_produits">
					<eqn>Tx_d&apos;obsolescence_du_capital*Capital_Fixe_Productif_B[Autres_produits]</eqn>
				</element>
			</flow>
			<aux name="Investissement par branche">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<eqn>Init_Ventilation_de_l&apos;investissement_par_branche*Converter_10</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Somme CFB">
				<eqn>SUM(Capital_Fixe_Productif_B)</eqn>
				<units>Euros</units>
			</aux>
			<aux name="Capital fixe Agro Alim">
				<eqn>Capital_Fixe_Productif_B[Agroalimentaire]</eqn>
			</aux>
			<aux name="Tx de croissance du CF Agro">
				<eqn>SMTH1(DERIVN(Capital_fixe_Agro_Alim,1)/Capital_fixe_Agro_Alim,3)</eqn>
			</aux>
			<aux name="Converter 10" access="input">
				<units>Euros</units>
			</aux>
			<aux name="Converter 11" access="input">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
			</aux>
			<aux name="Capital fixe sur VAB">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<eqn>Capital_Fixe_Productif_B/Converter_11</eqn>
			</aux>
			<aux name="Indice CFPB sur initial" access="output">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<eqn>Capital_fixe_sur_VAB/INIT(Capital_fixe_sur_VAB)</eqn>
			</aux>
			<aux name="Durée vie inv Agro">
				<eqn>20</eqn>
				<units>years</units>
			</aux>
			<aux name="Ventilation de l'investissement">
				<dimensions>
					<dim name="Branches"/>
				</dimensions>
				<element subscript="Agroalimentaire">
					<eqn>Part_de_l&apos;investissement_allant_à_l&apos;AgroAlim</eqn>
				</element>
				<element subscript="Construction_Immobilier">
					<eqn>Part_Immo</eqn>
				</element>
				<element subscript="Transport">
					<eqn>.04</eqn>
				</element>
				<element subscript="Tourisme_Hotellerie">
					<eqn>Part_tourisme</eqn>
				</element>
				<element subscript="Autres_produits">
					<eqn>1-Part_de_l&apos;investissement_allant_à_l&apos;AgroAlim-Part_Immo-Part_tourisme-.04</eqn>
				</element>
			</aux>
			<aux name="Part Immo">
				<eqn>.6-Part_de_l&apos;investissement_allant_à_l&apos;AgroAlim</eqn>
			</aux>
			<aux name="Part tourisme" access="output">
				<eqn>0.04</eqn>
			</aux>
			<isee:dependencies>
				<var name="Capacite_productive_AgroAlimentaire">
					<in>Converter_2</in>
				</var>
				<var name="Var_capacit_Agricole">
					<in>Capacite_productive_AgroAlimentaire</in>
					<in>Tx_de_croissance_du_CF_Agro</in>
					<in>Elasticite_production_agricole</in>
					<in>Converter_1</in>
				</var>
				<var name="Init_Ventilation_de_l'investissement_par_branche">
					<in>Ventilation_de_l&apos;investissement</in>
				</var>
				<var name="Capital_Productif">
					<in>Init_Capital_fixe_Branches</in>
				</var>
				<var name="Accumulation">
					<in>Investissement_par_branche</in>
				</var>
				<var name="Epargne_sur_demande">
					<in>Converter_3</in>
					<in>Converter_6</in>
					<in>Converter_4</in>
				</var>
				<var name="Init_Capital_fixe_Branches">
					<in>Init_Capital_Fixe_par_branche</in>
				</var>
				<var name="Obsolescence">
					<in>Capital_Productif</in>
					<in>Tx_d&apos;obsolescence_du_capital</in>
				</var>
				<var name="Obsolescence_AGR">
					<in>Durée_vie_inv_Agro</in>
					<in>Capacite_productive_AgroAlimentaire</in>
				</var>
				<var name="Capital_Fixe_Productif_B">
					<in>Init_Capital_Fixe_par_branche</in>
				</var>
				<var name="Investissement_réel_par_branche">
					<in>Investissement_par_branche</in>
				</var>
				<var name="Obsolescence_CF">
					<in>Tx_d&apos;obsolescence_du_capital</in>
					<in>Capital_Fixe_Productif_B</in>
				</var>
				<var name="Investissement_par_branche">
					<in>Init_Ventilation_de_l&apos;investissement_par_branche</in>
					<in>Converter_10</in>
				</var>
				<var name="Somme_CFB">
					<in>Capital_Fixe_Productif_B</in>
				</var>
				<var name="Capital_fixe_Agro_Alim">
					<in>Capital_Fixe_Productif_B</in>
				</var>
				<var name="Tx_de_croissance_du_CF_Agro">
					<in>Capital_fixe_Agro_Alim</in>
				</var>
				<var name="Capital_fixe_sur_VAB">
					<in>Converter_11</in>
					<in>Capital_Fixe_Productif_B</in>
				</var>
				<var name="Indice_CFPB_sur_initial">
					<in>Capital_fixe_sur_VAB</in>
				</var>
				<var name="Ventilation_de_l'investissement">
					<in>Part_de_l&apos;investissement_allant_à_l&apos;AgroAlim</in>
					<in>Part_tourisme</in>
					<in>Part_Immo</in>
				</var>
				<var name="Part_Immo">
					<in>Part_de_l&apos;investissement_allant_à_l&apos;AgroAlim</in>
				</var>
			</isee:dependencies>
		</variables>
		<views>
			<style color="black" background="white" font_style="normal" font_weight="normal" text_decoration="none" text_align="center" vertical_text_align="center" font_color="black" font_family="Arial" font_size="10pt" padding="2" border_color="black" border_width="thin" border_style="none">
				<text_box color="black" background="white" text_align="left" vertical_text_align="top" font_size="12pt"/>
				<numeric_display color="blue" background="white" font_size="9pt" isee:transparent="false"/>
				<graph color="black" background="white" font_size="12pt" axis_color="#666666" grid_color="#C8C8C8" isee:graph_area_color="white" legend_position="bottom" isee:transparent="false" isee:hide_border="false">
					<isee:series_styles>
						<isee:series_style color="blue" thickness="1"/>
						<isee:series_style color="red" thickness="1" pen_style="dot_dashed"/>
						<isee:series_style color="fuchsia" thickness="1" pen_style="dotted"/>
						<isee:series_style color="#008F44" thickness="1" pen_style="dashed"/>
						<isee:series_style color="#FF7F00" thickness="1"/>
